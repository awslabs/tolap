          "fieldRules": {
            "allowedFields": [
              "db.patients.name"
            ]
          }
        }
      },
      "expected": [
        {
          "name": "bare"
        }
      ]
    },
    {
      "name": "object-wildcard-keeps-own-object-and-bare-keys",
      "notes": "'patients.*' admits every column qualified with 'patients' and every bare key (the qualifier is implied by the result set), but never 'encounters.id'.",
      "action": "projectAllowedFields",
      "records": [
        {
          "patients.id": 1,
          "id": 2,
          "encounters.id": 3,
          "encounters.status": "open"
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "patients.*"
            ]
          }
        }
      },
      "expected": [
        {
          "patients.id": 1,
          "id": 2
        }
      ]
    },
    {
      "name": "object-wildcard-does-not-reach-a-deeper-qualifier",
      "notes": "'patients.address.city' has the qualifier 'patients.address', which is not 'patients', so 'patients.*' does not admit it. Fails toward not-allowed.",
      "action": "projectAllowedFields",
      "records": [
        {
          "patients.address.city": "x",
          "patients.id": 1
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
