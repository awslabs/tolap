        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "name"
            ]
          }
        }
      },
      "expected": [
        {
          "patients.name": "pat",
          "encounters.name": "enc",
          "name": "bare"
        }
      ]
    },
    {
