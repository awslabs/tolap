          "patients.NAME": "pat"
        }
      ]
    },
    {
      "name": "non-ascii-qualifier-folds-ascii-only-conflict",
      "notes": "'PAT\u0130ENTS' (U+0130) folds to 'pat\u0130ents', which is not 'pati\u0307ents' (i followed by U+0307). Full Unicode lower-casing would equate them in some SDKs and not others, so the qualifiers conflict and the key is dropped.",
      "action": "projectAllowedFields",
      "records": [
        {
          "pati\u0307ents.name": "combining-dot",
          "id": 1
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "PAT\u0130ENTS.name"
            ]
          }
        }
      },
      "expected": [
        {}
      ]
    },
    {
      "name": "non-ascii-qualifier-folds-ascii-only-match",
      "notes": "'PAT\u0130ENTS' and 'pat\u0130ents' differ only in ASCII letters, so they are the same qualifier and the key is kept.",
      "action": "projectAllowedFields",
      "records": [
        {
          "pat\u0130ents.NAME": "same",
          "id": 1
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "PAT\u0130ENTS.name"
            ]
          }
        }
      },
      "expected": [
        {
          "pat\u0130ents.NAME": "same"
        }
      ]
    },
    {
      "name": "longer-key-qualifier-is-a-different-object",
      "notes": "The qualifier is everything before the last '.', so 'db.patients' and 'patients' are different qualifiers and 'db.patients.name' is dropped. Fails toward not-allowed.",
      "action": "projectAllowedFields",
      "records": [
        {
          "db.patients.name": "long",
          "name": "bare"
        }
      ],
      "policy": {
        "version": "1.0",
