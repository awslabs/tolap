    {
      "name": "masking-matching-is-unchanged-across-objects",
      "notes": "Regression guard. maskedFields keeps the broad matcher: a mask on 'patients.ssn' still masks 'encounters.ssn'.",
      "action": "applyResultPipeline",
      "records": [
        {
          "encounters.ssn": "123",
          "name": "pat"
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "maskedFields": [
