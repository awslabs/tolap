          "PATIENTS.Name": "pat"
        }
      ]
    },
    {
      "name": "qualifier-case-variant-still-conflicts",
      "notes": "Case folding does not make a different object the same object: 'ENCOUNTERS.NAME' is dropped under 'Patients.Name'.",
      "action": "projectAllowedFields",
      "records": [
        {
          "ENCOUNTERS.NAME": "enc",
          "patients.NAME": "pat"
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
