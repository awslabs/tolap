          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "patients.name"
            ]
          }
        }
      },
      "expected": [
        {
          "name": "bare"
        }
      ]
    },
    {
      "name": "longer-entry-qualifier-is-a-different-object",
      "notes": "The reverse: the entry 'db.patients.name' does not admit the key 'patients.name'.",
      "action": "projectAllowedFields",
      "records": [
        {
          "patients.name": "short",
          "name": "bare"
        }
      ],
      "policy": {
        "version": "1.0",
