    {
      "name": "glob-qualifier-is-literal-against-a-qualified-key",
      "notes": "Glob characters in an entry's qualifier are literal for the qualifier comparison, as they are for row filters (#32). '*' is not 'patients' or 'encounters', so '*.name' admits no qualified key. Chosen to fail toward not-allowed: an author who means every object can write the bare 'name'.",
      "action": "projectAllowedFields",
      "records": [
        {
          "patients.name": "pat",
          "encounters.name": "enc",
          "name": "bare"
        }
      ],
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "allowedFields": [
              "*.name"
            ]
          }
        }
      },
      "expected": [
        {
          "name": "bare"
        }
      ]
    },
    {
      "name": "several-records-are-projected-independently",
      "notes": "A list of records: each record is projected on its own, and a record left with no allowed key becomes an empty record.",
      "action": "projectAllowedFields",
