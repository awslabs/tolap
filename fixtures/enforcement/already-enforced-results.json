        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "hiddenFields": [
              "ssn"
            ],
            "maskedFields": [
              {
                "field": "email",
                "maskType": "hash",
                "parameters": {
                  "algorithm": "sha256"
                }
              }
            ]
          },
          "rowFilters": [
            {
              "field": "region",
              "operator": "equals",
              "value": "us-east"
            }
          ]
        },
        "limits": {
          "maxResults": 2
        }
      },
      "marker": "context",
      "data": [
        {
          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        }
      ],
      "expected": [
        {
          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        }
      ]
    },
