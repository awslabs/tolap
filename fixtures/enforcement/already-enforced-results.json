            "id": 1,
            "region": "us-east",
            "email": "b36a83701f1c3191"
          },
          {
            "id": 2,
            "region": "us-east",
            "email": "2b3b2b9ce842ab8b"
          }
        ],
        "contextSignature": "$CONTEXT_SIGNATURE",
        "policySignature": "$CONTEXT_SIGNATURE",
        "__tolapEnforced": true
      },
      "expected": null,
      "notes": "The record has no region field, so the region row filter fails closed and drops it: null. Were the keys honoured, the enforced rows would be returned instead."
