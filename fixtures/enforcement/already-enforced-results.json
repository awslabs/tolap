          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        },
        {
          "id": 3,
          "region": "us-east",
          "email": "898628e28890f937"
        }
      ],
      "expected": [
        {
          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        }
      ],
      "notes": "Re-truncation is idempotent, so the limit is a backstop even when the marker is honoured."
    },
