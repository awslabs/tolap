    {
      "name": "matching marker keeps rows whose filter field the data layer already hid",
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "hiddenFields": [
              "status"
            ]
          },
          "rowFilters": [
            {
              "field": "status",
              "operator": "equals",
              "value": "active"
            }
          ]
        }
      },
      "marker": "context",
      "data": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Grace"
        }
      ],
      "expected": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Grace"
        }
      ]
    },
    {
      "name": "mismatched marker re-runs the row filter over hidden output and drops every row",
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "hiddenFields": [
              "status"
            ]
          },
          "rowFilters": [
            {
              "field": "status",
              "operator": "equals",
              "value": "active"
            }
          ]
        }
      },
      "marker": "tampered",
      "data": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Grace"
        }
      ],
      "expected": [],
      "notes": "Demonstrates why record-dropping steps are skipped for an honoured marker: a filter on a field the data layer already removed fails closed."
    }
  ],
  "notes": "Hashes are unsalted sha256, first 16 hex characters. Expected values for mismatched markers are the pipeline applied a second time to already-enforced data."
}
