{
  "description": "Already-enforced results: a tool opts out of re-enforcement by returning an EnforcedResult marker bound to the signed context's signature. Honoured only on an exact, constant-time signature match, and only by executeWithEnforcement. An honoured marker skips masking, the size ceiling, and each row filter, tag filter or similarity floor whose field the policy hides, projects out or masks. The filters on visible, unmasked, allowed fields, the hidden-field strip, the allowed-field projection and maxResults are re-applied, because over already-enforced output they are no-ops.",
  "action": "executeWithEnforcement",
  "signingKey": "already-enforced-fixture-key-0123456789abcdef",
  "context": {
    "userId": "user-1",
    "tenantId": "tenant-1"
  },
  "otherContext": {
    "userId": "user-2",
    "tenantId": "tenant-1"
  },
  "markers": {
    "context": "EnforcedResult bound to the signature of the context the call runs under",
    "otherContext": "EnforcedResult bound to the signature of a different context signed with the same key",
    "tampered": "EnforcedResult bound to the context signature with its last character changed",
    "empty": "EnforcedResult bound to an empty signature",
    "null": "the tool returns the data unwrapped"
  },
  "substitutions": {
    "$CONTEXT_SIGNATURE": "replace with the signature of the context the call runs under"
  },
  "cases": [
    {
      "name": "matching marker returns the enforced rows unchanged (no second hash)",
      "policy": {
        "version": "1.0",
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "fieldRules": {
            "hiddenFields": [
              "ssn"
            ],
            "maskedFields": [
              {
                "field": "email",
                "maskType": "hash",
                "parameters": {
                  "algorithm": "sha256"
                }
              }
            ]
          },
          "rowFilters": [
            {
              "field": "region",
              "operator": "equals",
              "value": "us-east"
            }
          ]
        },
        "limits": {
          "maxResults": 2
        }
      },
      "marker": "context",
      "data": [
        {
          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        }
      ],
      "expected": [
        {
          "id": 1,
          "region": "us-east",
          "email": "b36a83701f1c3191"
        },
        {
          "id": 2,
          "region": "us-east",
          "email": "2b3b2b9ce842ab8b"
        }
      ]
    },
