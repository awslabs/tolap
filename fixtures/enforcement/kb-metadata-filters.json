{
  "description": "Provider-side kb metadata filters built from tagRules (connector-spec section 7). One corpus, identical output in .NET, Python, and TypeScript. Every expectation here was produced by executing the implementation, not hand-derived. IMPORTANT: a provider filter is a PUSHDOWN and never a replacement for the post-retrieval pass. Post-retrieval tag extraction is recursive, case-insensitive, and spans tags/Tags/labels/classification/metadata.tags; no provider filter reproduces that. So a filter that matches nothing is useless, not unsafe. The property that MUST hold is the other direction: a pushdown must never exclude a chunk the policy permits, which is why an inexact rule is reported in unpushedRules instead of being approximated.",
  "cases": [
    {
      "name": "denylist-single-key",
      "note": "A denylist on one indexed key: the well-behaved case. notIn excludes exactly the denied tags and leaves an untagged chunk alone, matching the post pass.",
      "policy": {
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "tagRules": {
            "deniedTags": [
              "Secret",
              "restricted"
            ]
          }
        }
      },
      "metadataKeys": [
        "classification"
      ],
      "expected": {
        "clauses": [
          {
            "key": "classification",
            "op": "notIn",
            "values": [
              "restricted",
              "secret"
            ]
          }
        ],
        "deniesEverything": false,
        "unpushedRules": [],
        "rendered": {
          "bedrock": {
            "notIn": {
              "key": "classification",
              "value": [
                "restricted",
                "secret"
              ]
            }
          },
          "opensearch": {
            "bool": {
              "must_not": [
                {
                  "terms": {
                    "classification.keyword": [
                      "restricted",
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "elasticsearch": {
            "bool": {
              "must_not": [
                {
                  "terms": {
                    "classification.keyword": [
                      "restricted",
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "azureAiSearch": "not classification/any(t: search.in(t, 'restricted,secret'))",
          "vertexAiSearch": "NOT classification: ANY(\"restricted\", \"secret\")",
          "pgvector": "(NOT (metadata->'classification' ?| array['restricted', 'secret']) OR metadata->'classification' IS NULL)"
        }
      }
    },
    {
      "name": "allowlist-single-key",
      "note": "An allow-list on one key renders as a positive match. Exact only because there is a single key; see allowlist-multi-key-unpushable.",
      "policy": {
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "tagRules": {
            "allowedTags": [
              "public",
              "internal"
            ]
          }
        }
      },
      "metadataKeys": [
        "classification"
      ],
      "expected": {
        "clauses": [
          {
            "key": "classification",
            "op": "in",
            "values": [
              "internal",
              "public"
            ]
          }
        ],
        "deniesEverything": false,
        "unpushedRules": [],
        "rendered": {
          "bedrock": {
            "in": {
              "key": "classification",
              "value": [
                "internal",
                "public"
              ]
            }
          },
          "opensearch": {
            "bool": {
              "filter": [
                {
                  "terms": {
                    "classification.keyword": [
                      "internal",
                      "public"
                    ]
                  }
                }
              ]
            }
          },
          "elasticsearch": {
            "bool": {
              "filter": [
                {
                  "terms": {
                    "classification.keyword": [
                      "internal",
                      "public"
                    ]
                  }
                }
              ]
            }
          },
          "azureAiSearch": "classification/any(t: search.in(t, 'internal,public'))",
          "vertexAiSearch": "classification: ANY(\"internal\", \"public\")",
          "pgvector": "metadata->'classification' ?| array['internal', 'public']"
        }
      }
    },
    {
      "name": "both-denied-wins",
      "note": "Both rules push, combined with AND. Mirrors filterByTags precedence: denied wins.",
      "policy": {
        "permissions": {
          "canQuery": true
        },
        "objectRules": {
          "tagRules": {
            "allowedTags": [
              "public"
            ],
            "deniedTags": [
              "secret"
            ]
          }
        }
      },
      "metadataKeys": [
        "classification"
      ],
      "expected": {
        "clauses": [
          {
            "key": "classification",
            "op": "notIn",
            "values": [
              "secret"
            ]
          },
          {
            "key": "classification",
            "op": "in",
            "values": [
              "public"
            ]
          }
        ],
        "deniesEverything": false,
        "unpushedRules": [],
        "rendered": {
          "bedrock": {
            "andAll": [
              {
                "notIn": {
                  "key": "classification",
                  "value": [
                    "secret"
                  ]
                }
              },
              {
                "in": {
                  "key": "classification",
                  "value": [
                    "public"
                  ]
                }
              }
            ]
          },
          "opensearch": {
            "bool": {
              "filter": [
                {
                  "terms": {
                    "classification.keyword": [
                      "public"
                    ]
                  }
                }
              ],
              "must_not": [
                {
                  "terms": {
                    "classification.keyword": [
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "elasticsearch": {
            "bool": {
              "filter": [
                {
                  "terms": {
                    "classification.keyword": [
                      "public"
                    ]
                  }
                }
              ],
              "must_not": [
                {
                  "terms": {
                    "classification.keyword": [
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "azureAiSearch": "not classification/any(t: search.in(t, 'secret')) and classification/any(t: search.in(t, 'public'))",
          "vertexAiSearch": "NOT classification: ANY(\"secret\") AND classification: ANY(\"public\")",
          "pgvector": "(NOT (metadata->'classification' ?| array['secret']) OR metadata->'classification' IS NULL) AND metadata->'classification' ?| array['public']"
        }
      }
    },
    {
