        "classification"
      ],
      "expected": {
        "clauses": [
          {
            "key": "tags",
            "op": "notIn",
            "values": [
              "secret"
            ]
          },
          {
            "key": "classification",
            "op": "notIn",
            "values": [
              "secret"
            ]
          }
        ],
        "deniesEverything": false,
        "unpushedRules": [],
        "rendered": {
          "bedrock": {
            "andAll": [
              {
                "notIn": {
                  "key": "tags",
                  "value": [
                    "secret"
                  ]
                }
              },
              {
                "notIn": {
                  "key": "classification",
                  "value": [
                    "secret"
                  ]
                }
              }
            ]
          },
          "opensearch": {
            "bool": {
              "must_not": [
                {
                  "terms": {
                    "tags.keyword": [
                      "secret"
                    ]
                  }
                },
                {
                  "terms": {
                    "classification.keyword": [
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "elasticsearch": {
            "bool": {
              "must_not": [
                {
                  "terms": {
                    "tags.keyword": [
                      "secret"
                    ]
                  }
                },
                {
                  "terms": {
                    "classification.keyword": [
                      "secret"
                    ]
                  }
                }
              ]
            }
          },
          "azureAiSearch": "not tags/any(t: search.in(t, 'secret')) and not classification/any(t: search.in(t, 'secret'))",
          "vertexAiSearch": "NOT tags: ANY(\"secret\") AND NOT classification: ANY(\"secret\")",
          "pgvector": "(NOT (metadata->'tags' ?| array['secret']) OR metadata->'tags' IS NULL) AND (NOT (metadata->'classification' ?| array['secret']) OR metadata->'classification' IS NULL)"
        }
      }
    },
    {
      "name": "allowlist-multi-key-unpushable",
