    { "name": "W8-tool-gate-before-write-permission", "staticAllowedTools": [], "toolName": "delete_patient", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": false, "readOnly": false }, "objectRules": { "toolRules": { "hiddenTools": ["delete_patient"] } } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "W9-allowed-tool-still-needs-write-permission", "staticAllowedTools": [], "toolName": "write_note", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": true, "canInsert": false, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": ["write_note"] } } },
      "expected": { "allowed": false, "reason": "insert not permitted" } },
    { "name": "W10-context-before-tool-gate", "staticAllowedTools": [], "toolName": "delete_patient", "operation": "insert", "object": "notes", "payload": { "body": "x" }, "contextOverride": "expired",
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "hiddenTools": ["delete_patient"] } } },
      "expected": { "allowed": false, "reasonFamily": "expired" } },
    { "name": "W11-write-only-no-tool-rules", "staticAllowedTools": [], "toolName": "write_note", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false } },
      "expected": { "allowed": true } },
    { "name": "W12-name-omitted-write-check-still-runs", "staticAllowedTools": [], "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": true, "canInsert": false, "readOnly": false } },
      "expected": { "allowed": false, "reason": "insert not permitted" } }
