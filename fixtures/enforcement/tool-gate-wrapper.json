{
  "description": "Wrapper-level order for tool rules. There is no option: every MCP wrapper evaluates objectRules.toolRules whenever the policy carries it. Each SDK builds a signed context from the policy fragment, constructs the signed-context wrapper with allowed_tools = staticAllowedTools, and calls pre_execute(context, toolName) with no object, fields or endpoint. filterCases drive filter_tools(context, toolNames). writeCases extend the shape for the write path: each calls pre_write(context, operation, object, payload, toolName) (TS: preWrite(context, operation, object, payload, { toolName }); .NET: PreWrite(context, operation, object, payload, options: null, toolName)). A writeCase with no toolName key omits the argument entirely, which must leave the write path unchanged. operation is the write operation's string value; payload is a flat object of field values.",
  "reasonFamilies": {
    "expired": { "python": "security context expired", "typescript": "security context expired", "dotnet": "security context has expired" }
  },
  "cases": [
    { "name": "no-tool-rules-unchanged", "staticAllowedTools": [], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": true } },
      "expected": { "allowed": true } },
    { "name": "hidden", "staticAllowedTools": [], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "not-in-allowed-set", "staticAllowedTools": [], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "allowed", "staticAllowedTools": [], "toolName": "query_patients",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": true } },
    { "name": "tools-only-policy", "staticAllowedTools": [], "toolName": "query_patients",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": true } },
    { "name": "static-list-wins-first", "staticAllowedTools": ["query_patients"], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed list" } },
    { "name": "static-empty-policy-empty", "staticAllowedTools": [], "toolName": "query_patients",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": [] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "static-and-policy-intersect", "staticAllowedTools": ["query_patients", "count_patients"], "toolName": "count_patients",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "tool-rules-before-can-query", "staticAllowedTools": [], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": false }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "allowed-tool-still-needs-can-query", "staticAllowedTools": [], "toolName": "query_patients",
      "policy": { "permissions": { "canQuery": false }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "query not permitted" } },
    { "name": "B1", "staticAllowedTools": [], "toolName": "export_segment_csv", "contextOverride": "expired",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reasonFamily": "expired" } },
    { "name": "B2", "staticAllowedTools": [], "toolName": "export_segment_csv", "contextOverride": "wrongKey",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "invalid signature" } },
    { "name": "B3", "staticAllowedTools": ["a"], "toolName": "b",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["a"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed list" } },
    { "name": "B4", "staticAllowedTools": ["export_segment_csv"], "toolName": "export_segment_csv",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "B5", "staticAllowedTools": [], "toolName": "export_csv",
      "toolActionCategories": { "segment_overlap": "aggregate_overlap", "export_csv": "export_pii" },
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["export_csv"] } }, "purposeProfile": { "purposeId": "campaign-x-overlap", "allowedActions": ["aggregate_overlap"], "prohibitedActions": ["export_pii"] } },
      "expected": { "allowed": false, "reason": "action 'export_pii' is prohibited under purpose 'campaign-x-overlap'" } },
    { "name": "B6", "staticAllowedTools": [], "toolName": "export_csv",
      "toolActionCategories": { "segment_overlap": "aggregate_overlap", "export_csv": "export_pii" },
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_csv"] } }, "purposeProfile": { "purposeId": "campaign-x-overlap", "allowedActions": ["aggregate_overlap"], "prohibitedActions": ["export_pii"] } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "B7", "staticAllowedTools": [], "toolName": "query_patients",
      "policy": { "permissions": { "canQuery": false }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "query not permitted" } },
    { "name": "B8", "staticAllowedTools": [], "toolName": "query_patients", "object": "billing",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "allowedObjects": ["patients"], "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "object not in allowed set" } },
    { "name": "B9", "staticAllowedTools": [], "toolName": "query_patients", "object": "patients", "fields": ["name"],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": true } },
    { "name": "B10", "staticAllowedTools": [], "toolName": "export_segment_csv ",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } },
      "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "B11", "staticAllowedTools": [], "toolName": "export_segment_csv ",
      "policy": { "permissions": { "canQuery": true } },
      "expected": { "allowed": true } },
    { "name": "kelvin-sign-invalid-name", "staticAllowedTools": [], "toolName": "\u212Aill_switch",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["kill_switch"] } } },
      "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "mis-cased-not-in-allowed-set", "staticAllowedTools": [], "toolName": "Query_Patients",
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed set" } }
  ],
  "filterCases": [
    { "name": "filter-tool-rules", "staticAllowedTools": [],
      "toolNames": ["query_patients", "export_segment_csv", "count_patients", "admin_reset"],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients", "count_patients", "export_segment_csv"], "hiddenTools": ["Export_Segment_CSV"] } } },
      "expected": ["query_patients", "count_patients"] },
    { "name": "filter-no-tool-rules-lists-everything", "staticAllowedTools": [],
      "toolNames": ["query_patients", "export_segment_csv"],
      "policy": { "permissions": { "canQuery": true } },
      "expected": ["query_patients", "export_segment_csv"] },
    { "name": "filter-static-list-applies", "staticAllowedTools": ["export_segment_csv"],
      "toolNames": ["query_patients", "export_segment_csv"],
      "policy": { "permissions": { "canQuery": true } },
      "expected": ["export_segment_csv"] },
    { "name": "filter-ignores-can-query", "staticAllowedTools": [],
      "toolNames": ["write_note"],
      "policy": { "permissions": { "canQuery": false, "canInsert": true }, "objectRules": { "toolRules": { "allowedTools": ["write_note"] } } },
      "expected": ["write_note"] },
    { "name": "filter-deny-all-lists-nothing", "staticAllowedTools": [],
      "toolNames": ["query_patients", "write_note"],
      "policy": { "permissions": { "canQuery": false } },
      "expected": [] },
    { "name": "filter-deny-all-explicit-false-lists-nothing", "staticAllowedTools": ["write_note"],
      "toolNames": ["write_note"],
      "policy": { "permissions": { "canQuery": false, "canInsert": false, "canUpdate": false, "canDelete": false, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": ["write_note"] } } },
      "expected": [] },
    { "name": "filter-write-only-subject-to-tool-rules", "staticAllowedTools": [],
      "toolNames": ["write_note", "delete_patient", "Write_Note"],
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": ["write_note", "delete_patient"], "hiddenTools": ["DELETE_PATIENT"] } } },
      "expected": ["write_note"] },
    { "name": "filter-update-only-lists", "staticAllowedTools": [],
      "toolNames": ["update_note"],
      "policy": { "permissions": { "canQuery": false, "canUpdate": true } },
      "expected": ["update_note"] },
    { "name": "filter-delete-only-lists", "staticAllowedTools": [],
      "toolNames": ["delete_note"],
      "policy": { "permissions": { "canQuery": false, "canDelete": true } },
      "expected": ["delete_note"] },
    { "name": "filter-purpose-action-applies", "staticAllowedTools": [],
      "toolActionCategories": { "segment_overlap": "aggregate_overlap", "export_csv": "export_pii" },
      "toolNames": ["segment_overlap", "export_csv"],
      "policy": { "permissions": { "canQuery": true }, "purposeProfile": { "purposeId": "campaign-x-overlap", "allowedActions": ["aggregate_overlap"], "prohibitedActions": ["export_pii"] } },
      "expected": ["segment_overlap"] },
    { "name": "C1", "staticAllowedTools": [], "toolNames": [],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["x"] } } }, "expected": [] },
    { "name": "C2", "staticAllowedTools": [], "toolNames": ["a", "a", "b"],
      "policy": { "permissions": { "canQuery": true } }, "expected": ["a", "a", "b"] },
    { "name": "C3", "staticAllowedTools": [], "toolNames": ["query_patients", "export_segment_csv "],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["admin_reset"] } } }, "expected": ["query_patients"] },
    { "name": "C4", "staticAllowedTools": [], "toolNames": ["query_patients", "count_patients"],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": [] } } }, "expected": [] },
    { "name": "C5", "staticAllowedTools": [], "toolNames": ["query_patients"], "contextOverride": "expired",
      "policy": { "permissions": { "canQuery": true } }, "expected": [] },
    { "name": "C6", "staticAllowedTools": [], "toolNames": ["query_patients"], "contextOverride": "wrongKey",
      "policy": { "permissions": { "canQuery": true } }, "expected": [] },
    { "name": "filter-no-tool-rules-no-grammar", "staticAllowedTools": [], "toolNames": ["export_segment_csv "],
      "policy": { "permissions": { "canQuery": true } }, "expected": ["export_segment_csv "] },
    { "name": "filter-mis-cased-dropped", "staticAllowedTools": [], "toolNames": ["Query_Patients", "query_patients"],
      "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } },
      "expected": ["query_patients"] }
  ],
  "writeCases": [
    { "name": "W1-write-only-allowed-write-tool", "staticAllowedTools": [], "toolName": "write_note", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": ["write_note"] } } },
      "expected": { "allowed": true } },
    { "name": "W2-write-only-hidden", "staticAllowedTools": [], "toolName": "delete_patient", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "hiddenTools": ["delete_patient"] } } },
      "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "W3-not-in-allowed-set", "staticAllowedTools": [], "toolName": "export_segment_csv", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": ["write_note"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "W4-invalid-tool-name", "staticAllowedTools": [], "toolName": "write_note ", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "hiddenTools": ["admin_reset"] } } },
      "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "W5-name-omitted-unchanged", "staticAllowedTools": ["query_patients"], "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "allowedTools": [], "hiddenTools": ["write_note"] } } },
      "expected": { "allowed": true } },
    { "name": "W6-static-list-miss", "staticAllowedTools": ["query_patients"], "toolName": "write_note", "operation": "insert", "object": "notes", "payload": { "body": "x" },
      "policy": { "permissions": { "canQuery": false, "canInsert": true, "readOnly": false }, "objectRules": { "toolRules": { "hiddenTools": ["write_note"] } } },
      "expected": { "allowed": false, "reason": "tool not in allowed list" } },
    { "name": "W7-hide-differs-only-in-ascii-case", "staticAllowedTools": [], "toolName": "delete_patient", "operation": "insert", "object": "notes", "payload": { "body": "x" },
