{
  "description": "validateToolAccess(toolName, policy): objectRules.toolRules only. Hidden before allowed; allowedTools exact and case-sensitive, hiddenTools case-insensitive (both directions deny a mis-cased name). Absent = unrestricted, allowedTools [] = deny every tool, hiddenTools [] hides nothing. canQuery is NOT consulted here -- the wrapper checks it after.",
  "cases": [
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true } }, "expected": { "allowed": true } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "allowedObjects": ["patients"] } }, "expected": { "allowed": true } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": {} } }, "expected": { "allowed": true } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients", "count_patients"] } } }, "expected": { "allowed": true } },
    { "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": [] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "toolName": "Query_Patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "toolName": "Export_Segment_CSV", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["export_segment_csv"], "hiddenTools": ["EXPORT_SEGMENT_CSV"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": [] } } }, "expected": { "allowed": true } },
    { "toolName": "query_patients", "policy": { "permissions": { "canQuery": false }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"] } } }, "expected": { "allowed": true } },
    { "name": "A1", "toolName": "", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["x"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A2", "toolName": "export_segment_csv ", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A3", "toolName": " export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A4", "toolName": "export_segment_csv\n", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A5", "toolName": "export_segment_csv\u0000", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A6", "toolName": "\u212Aill_switch", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["kill_switch"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A7", "toolName": "expört", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["expört"] } } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A8", "toolName": "export/segment", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": {} } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A9", "toolName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"] } } }, "expected": { "allowed": true } },
    { "name": "A10", "toolName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": {} } }, "expected": { "allowed": false, "reason": "invalid tool name" } },
    { "name": "A11", "toolName": "tools.query-v2_x", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["tools.query-v2_x"] } } }, "expected": { "allowed": true } },
    { "name": "A12", "toolName": "export_segment_csv ", "policy": { "permissions": { "canQuery": true } }, "expected": { "allowed": true } },
    { "name": "A13", "toolName": "EXPORT_SEGMENT_CSV", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "A14", "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["EXPORT_SEGMENT_CSV"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "A15", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["QUERY_PATIENTS"] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "A16", "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["export"] } } }, "expected": { "allowed": true } },
    { "name": "A17", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query"] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "A18", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_*"] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "A19", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": null } } }, "expected": { "allowed": true } },
    { "name": "A20", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": null } } }, "expected": { "allowed": true } },
    { "name": "A21", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": [], "hiddenTools": [] } } }, "expected": { "allowed": false, "reason": "tool not in allowed set" } },
    { "name": "A22", "toolName": "export_segment_csv", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients"], "hiddenTools": ["export_segment_csv"] } } }, "expected": { "allowed": false, "reason": "tool is hidden" } },
    { "name": "A23", "toolName": "query_patients", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "allowedTools": ["query_patients", "query_patients"] } } }, "expected": { "allowed": true } },
    { "name": "A24", "toolName": "kill_switch", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["\u212Aill_switch"] } } }, "expected": { "allowed": true } },
    { "name": "A25", "toolName": "secret_export", "policy": { "permissions": { "canQuery": true }, "objectRules": { "toolRules": { "hiddenTools": ["\u017Fecret_export"] } } }, "expected": { "allowed": true } }
  ]
}
