node_modules/
# Synthesized output: regenerated by `cdk synth` and it embeds account ids and
# staged asset copies, so it does not belong in a public repository.
cdk.out/
# Caches AZ lookups keyed by account id. Regenerated on first synth, and committing
# it would publish the account this was deployed from.
cdk.context.json
# Compiled output from the TypeScript stacks, which live in lib/ and bin/. Scoped, not
# blanket: a bare `*.js` also matched `lambda/seed-admin.js`, which is HAND-WRITTEN source
# (a custom-resource handler that must stay plain JS for the inline Lambda runtime) and was
# silently never committed -- taking the whole 46-assertion test suite with it, since the
# tests read that file.
lib/**/*.js
lib/**/*.d.ts
bin/**/*.js
bin/**/*.d.ts
test/**/*.js
test/**/*.d.ts
