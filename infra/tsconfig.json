{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // The CDK app runs under `node --experimental-strip-types`, so imports name the
    // .ts file that exists on disk.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["bin", "lib", "test"],
  "exclude": ["node_modules", "cdk.out"]
}
