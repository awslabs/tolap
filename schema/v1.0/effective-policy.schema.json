{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolap.dev/schema/v1.0/effective-policy.schema.json",
  "title": "TOLAP Effective Policy",
  "description": "The merged result of all applicable TOLAP policies for a specific user and data source. This is the resolved policy that gets signed, serialized, and transported to the tool execution environment for enforcement.",
  "type": "object",
  "required": [
    "version",
    "userId",
    "tenantId",
    "sourceConnectionId",
    "resolvedAt",
    "expiresAt",
    "sourceProfiles",
    "permissions",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for validation tooling."
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "TOLAP schema version. Must be '1.0' for this schema."
    },
    "userId": {
      "type": "string",
      "description": "Unique identifier of the user this effective policy applies to."
    },
    "tenantId": {
      "type": "string",
      "description": "Tenant context for this effective policy."
    },
    "sourceConnectionId": {
      "type": "string",
      "description": "Data source connection this effective policy governs."
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this effective policy was computed."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this effective policy expires. The tool wrapper must reject expired policies."
    },
    "sourceProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Names of the policy definitions that were merged to produce this effective policy. Included for audit trail."
    },
    "permissions": {
      "type": "object",
      "required": [
        "canQuery"
      ],
      "additionalProperties": false,
      "properties": {
        "canQuery": {
          "type": "boolean"
        },
        "canExport": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "objectRules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Merged object access rules. Same structure as policy definition objectRules, but values reflect the merge result.",
      "properties": {
        "allowedObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hiddenObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hiddenFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maskedFields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "maskType"
                ],
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "maskType": {
                    "type": "string",
                    "enum": [
                      "full",
                      "partial",
                      "hash",
                      "null",
                      "redact"
                    ]
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "showFirst": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "showLast": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "maskChar": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1
                      },
                      "algorithm": {
                        "type": "string",
                        "enum": [
                          "sha256",
                          "sha512",
                          "blake2b"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "readOnlyFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rowFilters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "operator"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "notEquals",
                  "in",
                  "notIn",
                  "greaterThan",
                  "lessThan",
                  "contains",
                  "startsWith",
                  "matches"
                ]
              },
              "value": {},
              "values": {
                "type": "array",
                "items": {}
              }
            }
          }
        },
        "tagRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedTags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedTags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "endpointRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedEndpoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hiddenEndpoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedMethods": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "GET",
                  "HEAD",
                  "OPTIONS",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxResults": {
          "type": "integer",
          "minimum": 1
        },
        "maxQueryTimeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "minSimilarityScore": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "maxObjectSizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "signature"
      ],
      "additionalProperties": false,
      "description": "Cryptographic integrity verification. The tool wrapper must validate the signature before enforcing the policy.",
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "hmac-sha256",
            "hmac-sha512",
            "ed25519"
          ],
          "description": "Signing algorithm used to generate the signature."
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded signature over the policy content (all fields except integrity)."
        }
      }
    }
  }
}
