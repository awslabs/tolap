{
  "name": "@tolap/policy-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of the TOLAP Policy Service: central policy management with server-side resolution and signing.",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "dev": "node --experimental-strip-types src/index.ts",
